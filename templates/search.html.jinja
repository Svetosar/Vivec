{% extends "layout.html.jinja" %}

{% block title %}
{% if query %}Поиск: {{ query }} — Vivec{% else %}Поиск — Vivec{% endif %}
{% endblock %}

{% block masthead %}
<div class="masthead-small">
  <a class="brand" href="/">Vivec</a>
  <a class="back-link" href="/">← Все статьи</a>
</div>
{% endblock %}

{% block content %}
<div class="search-wrap">
  <p class="rubric-kicker">Поиск</p>
  <h1 class="rubric-title">
    {% if query %}«{{ query }}»{% else %}Что найти?{% endif %}
  </h1>

  {% if query %}
  <p class="rubric-count">
    {% if articles|length == 0 %}
    Ничего не найдено
    {% else %}
    Найдено: {{ articles|length }}
    {% endif %}
  </p>
  {% else %}
  <p class="rubric-count">Введите слово или фразу в поле поиска.</p>
  {% endif %}

  {% if articles %}
  <div class="rubric-list">
    {% for a in articles %}
    <article class="rubric-item">
      <p class="card-rubric"><a href="/rubric/{{ a.rubric_slug }}">{{ a.rubric }}</a></p>
      <h2 class="rubric-item-title"><a href="/{{ a.slug }}">{{ a.title }}</a></h2>
      <p class="rubric-item-lead">{{ a.lead }}</p>
      <p class="rubric-item-meta">{{ a.author }} · {{ a.date }}</p>
    </article>
    {% endfor %}
  </div>
  {% elif query %}
  <p class="rubric-empty">Попробуйте другое слово или проверьте раскладку.</p>
  {% endif %}
</div>
{% endblock %}
