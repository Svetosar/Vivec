{% extends "layout.html.jinja" %}

{% block title %}Vivec — школьная газета{% endblock %}

{% block content %}

{% if hero %}
<article class="hero">
  <p class="kicker">{{ hero.rubric }}</p>
  <h1 class="hero-title"><a href="/{{ hero.slug }}">{{ hero.title }}</a></h1>
  <p class="hero-lead">{{ hero.lead }}</p>
  <p class="hero-meta">{{ hero.author }} · {{ hero.date }}</p>
</article>
{% else %}
<article class="hero">
  <h1 class="hero-title">Пока пусто</h1>
  <p class="hero-lead">Ни одна статья ещё не опубликована.</p>
</article>
{% endif %}

{% if cards %}
<div class="card-list">
  {% for a in cards %}
  <article class="card">
    <p class="card-rubric">{{ a.rubric }}</p>
    <h2 class="card-title"><a href="/{{ a.slug }}">{{ a.title }}</a></h2>
    <p class="card-excerpt">{{ a.lead }}</p>
    <p class="card-meta">{{ a.author }} · {{ a.date }}</p>
  </article>
  {% endfor %}
</div>
{% endif %}

{% endblock %}
